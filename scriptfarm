local espTags = {}

local function clearEsp()
    for _, tag in ipairs(espTags) do pcall(function() tag:Destroy() end) end
    table.clear(espTags)
end

local function buildEsp()
    clearEsp()
    if not state.esp then return end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Parent then
            local adornee = v.Parent:IsA("BasePart") and v.Parent
                or v.Parent:FindFirstChildWhichIsA("BasePart")
            if adornee and not (player.Character and adornee:IsDescendantOf(player.Character)) then
                local bb = Instance.new("BillboardGui")
                bb.Name = "CrimESP"
                bb.Adornee = adornee
                bb.Size = UDim2.fromOffset(120, 24)
                bb.AlwaysOnTop = true
                bb.MaxDistance = 350
                bb.Parent = guiParent

                local txt = Instance.new("TextLabel")
                txt.Size = UDim2.fromScale(1, 1)
                txt.BackgroundTransparency = 1
                local label = (v.ObjectText ~= "" and v.ObjectText)
                    or (v.ActionText ~= "" and v.ActionText)
                    or v.Parent.Name
                txt.Text = "• " .. label
                txt.TextColor3 = isSellPrompt(v) and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 210, 60)
                txt.TextStrokeTransparency = 0.2
                txt.Font = Enum.Font.GothamBold
                txt.TextSize = 12
                txt.Parent = bb
                table.insert(espTags, bb)
            end
        end
    end
end

task.spawn(function()
    while task.wait(5) do
        if state.esp then pcall(buildEsp) end
    end
end)


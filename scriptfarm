local function makeToggle(text, key, onChange)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 30)
    b.BorderSizePixel = 0
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.Gotham
    b.TextSize = 14
    b.Parent = holder
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local function refresh()
        b.Text = text .. ": " .. (state[key] and "ВКЛ" or "ВЫКЛ")
        b.BackgroundColor3 = state[key] and ON or OFF
    end
    b.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        refresh()
        if onChange then onChange(state[key]) end
    end)
    refresh()
    return refresh
end

local function makeButton(text, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 30)
    b.BorderSizePixel = 0
    b.BackgroundColor3 = Color3.fromRGB(70, 90, 160)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.Gotham
    b.TextSize = 13
    b.Text = text
    b.Parent = holder
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(cb)
end

local function makeInput(labelText, key, isNumber, minV)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -6, 0, 30)
    f.BackgroundTransparency = 1
    f.Parent = holder

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0.6, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text = labelText
    l.TextColor3 = Color3.new(1, 1, 1)
    l.Font = Enum.Font.Gotham
    l.TextSize = 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f

    local t = Instance.new("TextBox")
    t.Size = UDim2.new(0.4, 0, 1, 0)
    t.Position = UDim2.fromScale(0.6, 0)
    t.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    t.BorderSizePixel = 0
    t.Text = tostring(state[key])
    t.TextColor3 = Color3.new(1, 1, 1)
    t.Font = Enum.Font.Gotham
    t.TextSize = 13
    t.Parent = f
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 6)

    t.FocusLost:Connect(function()
        if isNumber then
            local n = tonumber(t.Text)
            if n and n >= (minV or 0) then state[key] = n end
        else
            state[key] = t.Text
        end
        t.Text = tostring(state[key])
    end)
end


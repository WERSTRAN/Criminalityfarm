---------------------------------------------------------------------
-- Вспомогательные функции
---------------------------------------------------------------------
local function getRoot()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getPos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local part = inst:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position
end

local function firePrompt(v)
    pcall(function()
        v.HoldDuration = 0
        if fireproximityprompt then
            fireproximityprompt(v)
        else
            v:InputHoldBegin()
            task.wait()
            v:InputHoldEnd()
        end
    end)
end

local function isSellPrompt(v)
    local kw = state.keyword:lower()
    if kw == "" then return false end
    local par = v.Parent
    local text = (v.ObjectText .. " " .. v.ActionText .. " "
        .. (par and par.Name or "") .. " "
        .. (par and par.Parent and par.Parent.Name or "")):lower()
    return text:find(kw, 1, true) ~= nil
end


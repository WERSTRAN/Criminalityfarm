---------------------------------------------------------------------
-- Движение
---------------------------------------------------------------------
local function travelTo(pos)
    local root = getRoot()
    if not root then return end
    local dist = (pos - root.Position).Magnitude
    local t = TweenService:Create(
        root,
        TweenInfo.new(math.max(dist / state.speed, 0.1), Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) }
    )
    currentTween = t
    traveling = true
    t:Play()
    t.Completed:Wait()
    traveling = false
end

---------------------------------------------------------------------
-- Авто-сбор рядом
---------------------------------------------------------------------
task.spawn(function()
    while task.wait(0.2) do
        if state.autoPickup then
            local root = getRoot()
            if root then
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") and v.Enabled then
                        local pos = getPos(v.Parent)
                        if pos and (pos - root.Position).Magnitude <= math.min(state.range, v.MaxActivationDistance) then
                            firePrompt(v)
                        end
                    end
                end
            end
        end
    end
end)

---------------------------------------------------------------------
-- Поиск целей
---------------------------------------------------------------------
local function nearestLoot()
    local root = getRoot()
    if not root then return end
    local best, bestDist
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Enabled and v.Parent and not isSellPrompt(v) then
            if not visited[v] or os.clock() - visited[v] > 60 then
                local pos = getPos(v.Parent)
                if pos then
                    local d = (pos - root.Position).Magnitude
                    if not bestDist or d < bestDist then
                        best, bestDist = v, d
                    end
                end
            end
        end
    end
    return best
end

local function findSellTarget()
    local root = getRoot()
    if not root then return end
    local bestPos, bestDist
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Parent and isSellPrompt(v) then
            local pos = getPos(v.Parent)
            if pos then
                local d = (pos - root.Position).Magnitude
                if not bestDist or d < bestDist then
                    bestPos, bestDist = pos, d
                end
            end
        end
    end
    return bestPos or sellPos
end

---------------------------------------------------------------------
-- Продажа
---------------------------------------------------------------------
local statusLabel

local function setStatus(t)
    if statusLabel then statusLabel.Text = t end
end

local function doSell()
    local pos = findSellTarget()
    if not pos then
        setStatus("Дилер не найден")
        lastSell = os.clock()
        return
    end
    busy = true
    setStatus("Еду продавать...")
    pcall(travelTo, pos)
    task.wait(0.4)
    local root = getRoot()
    if root then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") and v.Enabled then
                local p = getPos(v.Parent)
                if p and (p - root.Position).Magnitude <= 20 then
                    firePrompt(v)
                    task.wait(0.3)
                end
            end
        end
    end
    task.wait(1)
    lastSell = os.clock()
    busy = false
    setStatus("Продано")
end

---------------------------------------------------------------------
-- Главный цикл
---------------------------------------------------------------------
task.spawn(function()
    while task.wait(0.3) do
        if not busy then
            if state.autoSell and os.clock() - lastSell >= state.sellEvery then
                pcall(doSell)
            elseif state.autoWalk then
                local prompt = nearestLoot()
                if prompt then
                    visited[prompt] = os.clock()
                    local pos = getPos(prompt.Parent)
                    if pos then
                        setStatus("Иду к: " .. (prompt.Parent.Name))
                        pcall(travelTo, pos)
                        task.wait(0.6)
                    end
                else
                    setStatus("Лут не найден")
                end
            end
        end
    end
end)

